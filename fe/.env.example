# Optional. Leave commented to use the page's hostname: ws://<current-host>:4000 (wss on HTTPS).
# Uncomment only when the backend runs elsewhere.
# VITE_WS_BASE_URL=ws://localhost:4000

# true: retry disconnected sockets automatically; false: use the Reconnect button.
VITE_AUTO_RECONNECT=true

# Session-only observed trail for the selected aircraft (off by default).
VITE_OBSERVED_TRAILS=false
# Maximum positions per aircraft (2-10000); oldest positions are discarded.
VITE_TRAIL_MAX_POINTS=1000
